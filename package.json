{
  "name": "shoala-stores",
  "version": "1.0.0",
  "description": "نظام مخازن الشعلة لإدارة المخازن",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "sqlite",
    "inventory",
    "arabic"
  ],
  "author": "Al-Shoala Dev",
  "license": "ISC",
  "dependencies": {
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.shoala.stores",
    "productName": "مخازن الشعلة",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "directories": {
      "output": "dist"
